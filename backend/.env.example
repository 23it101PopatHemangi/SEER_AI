PORT=8000
# Database configuration (defaults to SQLite fallback: sqlite:///./seer_ai.db)
# DATABASE_URL=postgresql://user:password@localhost:5432/seer_ai_db

# Optional: GitHub personal access token to prevent API rate limit issues (60 requests/hr anonymously vs 5000 requests/hr authenticated)
# GITHUB_TOKEN=your_github_token_here

# GitHub OAuth / GitHub App Credentials (required for Connect GitHub Account flow)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/callback
